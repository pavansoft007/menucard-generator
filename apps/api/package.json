{
  "name": "@gc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "migrate": "tsx --env-file=../../.env src/db/migrate.ts up",
    "migrate:down": "tsx --env-file=../../.env src/db/migrate.ts down",
    "seed": "tsx --env-file=../../.env src/db/seed.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsup",
    "start:prod": "node --env-file=../../.env dist/server.js",
    "migrate:prod": "node --env-file=../../.env dist/db/migrate.js up",
    "seed:prod": "node --env-file=../../.env dist/db/seed.js"
  },
  "dependencies": {
    "@gc/shared-types": "*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fflate": "^0.8.3",
    "file-type": "^22.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.17.0",
    "sequelize": "^6.37.5",
    "sharp": "^0.35.5",
    "umzug": "^3.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "vitest": "^5.1.0"
  }
}
