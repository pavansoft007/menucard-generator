# API
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=goldencrunch
DB_USER=goldencrunch
DB_PASSWORD=goldencrunch
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5180
UPLOAD_DIR=../../uploads
ADMIN_EMAIL=admin@goldencrunch.local
ADMIN_PASSWORD=ChangeMe123!

# Export (PDF / PNG) – headless Chrome opens the web app's /render route
RENDER_BASE_URL=http://localhost:5180
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_NO_SANDBOX=true   # needed when running as root in Docker
EXPORT_DIR=../../exports
WEB_DIST=../web/dist

# Production
# FORCE_HTTPS=true         # set when TLS is terminated in front of the app (enables HSTS)
# TRUST_PROXY=1            # number of reverse proxies in front, so rate limits see real client IPs
