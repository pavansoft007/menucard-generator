# Copy to .env.production and fill in. Never commit the real file.

# --- secrets (required) ---
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-db
JWT_SECRET=                      # at least 32 random characters:  openssl rand -hex 48
ADMIN_EMAIL=owner@your-restaurant.com
ADMIN_PASSWORD=                  # first administrator's password (10+ characters, letters and numbers)

# --- optional ---
DB_NAME=goldencrunch
DB_USER=goldencrunch
APP_PORT=4000                    # host port the app is published on
PUBLIC_URL=http://localhost:4000 # the address people use in the browser (CORS)
JWT_EXPIRES_IN=8h
FORCE_HTTPS=false                # true once TLS is terminated in front of the app (enables HSTS)
TRUST_PROXY=                     # 1 when behind one reverse proxy, so rate limits see real client IPs
